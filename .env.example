# Локальные настройки. Скопируйте в .env; значения токенов здесь не храните.
VK_GROUP_ID=quetzalcoatl_cosplay
VK_TOKEN_FILE=secrets/vk-token.txt
# Существующий пост, созданный в VK с режимом «только для донов навсегда».
VK_DONUT_REFERENCE_POST=
# ID того же поста после проверки владельцем режима «только для донов навсегда».
# Нужен, если VK не возвращает paid_duration; не заменяет явно конечный срок.
VK_DONUT_PERMANENT_CONFIRMED_POST=
# true только после фактической проверки видимости вложений администратором,
# доном и обычным подписчиком; порядок описан в docs/vk.md.
VK_PHOTO_PRIVACY_VERIFIED=false
VK_TIMEOUT_MS=60000
